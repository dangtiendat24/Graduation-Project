# ============================================================
# ai-service — Environment Variables
# Copy file này thành .env và điền giá trị thực
# KHÔNG commit file .env vào git
# ============================================================

PORT=8000
HOST=0.0.0.0

# OpenAI (chỉ dùng cho embeddings CV/JD — xem app/services/embeddings.py)
OPENAI_API_KEY=your_openai_api_key_here

# Groq (dùng cho agent1 resume-parser và agent2 matching)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Qdrant Vector DB
# Local/Docker: dùng QDRANT_HOST/QDRANT_PORT
# Production (Qdrant Cloud): set QDRANT_URL + QDRANT_API_KEY — ghi đè QDRANT_HOST/PORT
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_URL=https://xxx.cloud.qdrant.io
# QDRANT_API_KEY=your-qdrant-cloud-api-key

# PostgreSQL (ai-service gọi trực tiếp để cập nhật kết quả agent)
DB_HOST=localhost
DB_PORT=5432
DB_USER=smart_user
DB_PASSWORD=smart_password
DB_NAME=smart_recruitment

# NestJS BE (callback URL để AI service notify khi agent hoàn thành)
BE_INTERNAL_URL=http://localhost:3000
BE_INTERNAL_SECRET=your-internal-api-secret-key

# Google Calendar (agent4_scheduling) — JSON key của Service Account (1 dòng, escape \n trong private_key)
# Cần: (1) bật domain-wide delegation cho client_id của service account trong Google Workspace Admin,
# scope https://www.googleapis.com/auth/calendar.readonly; (2) mỗi hr_email dùng tính năng gợi ý lịch
# phải thuộc cùng Workspace domain đã cấp delegation đó.
# GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}
